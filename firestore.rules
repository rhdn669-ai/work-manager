rules_version = '2';

// ⛔ 읽기 전용 (2026-09-10 대표님 「막아줘」)
//
// 앱은 2026-09-08 부터 사내 서버(https://srv.iopn.co.kr)를 쓴다. 그런데 옛 앱을 띄워 둔
// 기기가 남아 있어 그 기기의 작업이 여기에만 저장됐고, 자료가 두 곳으로 갈라져 91건을
// 손으로 합쳐야 했다(메티스 끝난 호기가 PC 6 · 태블릿 3 으로 갈리던 일).
//
// 그래서 여기는 «읽기만» 되게 막는다.
//   · 옛 앱을 열어도 저장이 실패한다 — 더 갈라지지 않는다
//   · 읽기는 되므로 옛 화면이 백지가 되지는 않는다
//   · 지금 앱은 사내 서버를 보므로 아무 영향이 없다
//
// 되돌리려면: scratchpad 의 firestore.rules.before 로 되돌리고 다시 올린다.
// 사내 서버를 접고 구글로 돌아가야 할 때만 그렇게 한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 메일 — 예전부터 로그인한 사람만 볼 수 있었다. 쓰기는 이제 막는다.
    match /mailThreads/{doc=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /mailReplies/{doc=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 나머지 — 읽기만.
    match /{col}/{doc=**} {
      allow read: if !(col in ['mailThreads', 'mailReplies']);
      allow write: if false;
    }
  }
}
